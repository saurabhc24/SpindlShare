// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth v5) Prisma adapter models ---
// Used exclusively for app login (Google OAuth + email magic link).
// Playlist-source connections (Spotify/YouTube) are stored separately
// in ConnectedAccount below, never here.

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  /// Set when an admin deletes the account. The row survives so the deletion can
  /// be counted and undone, which means every path that could resurface the
  /// account has to exclude it -- the public profile lookup, the rename
  /// redirect, the cleanup cron, and sign-in itself.
  deletedAt     DateTime?
  /// Where `email` goes when the account is deleted.
  ///
  /// `email` carries a unique index, so leaving the address in place would bar
  /// that person from ever signing up again -- the one genuinely destructive
  /// thing a *reversible* delete could do. Moving it here frees the index and
  /// still leaves the address on the row, so a restore can put it back.
  deletedEmail  String?
  deletedReason String?   @db.VarChar(280)

  accounts          Account[]
  sessions          Session[]
  profile           Profile?
  connectedAccounts ConnectedAccount[]
  playlists         Playlist[]
  usernameHistory   UsernameHistory[]

  // No @@index([deletedAt]) here on purpose. Deleted rows are a small minority
  // and every query on this column looks for exactly those, so the index wants
  // to be partial -- which the schema language can't express. It is created in
  // SQL by the migration instead, the same way Profile_visible_idx is.
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App models ---

model Profile {
  id     String @id @default(cuid())
  userId String @unique

  /// As typed by the user, for display only. Never used for lookups.
  username           String
  /// NFKC + lowercase. The uniqueness key and the only lookup path.
  /// Postgres `citext` would work too, but Prisma can only model it as
  /// Unsupported(), which is unusable in typed where clauses.
  usernameNormalized String @unique

  displayName    String?
  bio            String? @db.VarChar(280)
  avatarUrl      String?
  theme          String  @default("default")
  /// How the public page arranges playlists: "stacked" or "arc". A string
  /// rather than an enum -- adding a layout should not need a migration that
  /// rewrites every row, which is what altering a Postgres enum costs.
  playlistLayout String  @default("stacked")

  /// The user's own visibility choice, editable from Settings.
  isPublic        Boolean   @default(true)
  /// Moderation override, settable only by an admin. Kept separate from
  /// isPublic so a suspended user can't simply un-hide themselves.
  suspendedAt     DateTime?
  /// Why it was suspended -- shown in the admin list, never to the public.
  suspendedReason String?   @db.VarChar(280)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Retains usernames a profile has released, so old links can 301 to the current
/// one instead of 404ing once renames ship. Unique on the normalized name: when a
/// name is re-claimed by someone else the stale row is deleted, so a name maps to
/// at most one redirect target.
model UsernameHistory {
  id                 String   @id @default(cuid())
  usernameNormalized String   @unique
  username           String
  userId             String
  changedAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// SPOTIFY and YOUTUBE can be connected over OAuth and imported from. OTHER
/// cannot -- it is whatever service a user pastes next -- and exists so a
/// playlist can still be listed by link with a title the user supplies. See
/// ConnectableProvider in lib/providers: the type system, not a convention, is
/// what stops it reaching the OAuth code paths.
///
/// AMAZON is retained but unreachable. Nothing produces it, and a Postgres enum
/// value cannot be dropped without recreating the type and rewriting every row
/// that references it -- which, for a value no row uses, is not worth doing.
enum MusicProvider {
  SPOTIFY
  YOUTUBE
  AMAZON
  OTHER
}

model ConnectedAccount {
  id                    String        @id @default(cuid())
  userId                String
  provider              MusicProvider
  providerAccountId     String?
  accessTokenEncrypted  String?       @db.Text
  refreshTokenEncrypted String?       @db.Text
  scope                 String?
  expiresAt             DateTime?
  lastSyncedAt          DateTime?
  lastSyncStatus        String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  playlists Playlist[]

  @@unique([userId, provider])
}

/// One row per day, incremented by the visit beacon.
///
/// A row per visit would be the obvious shape and the wrong one: it grows
/// without bound, and nothing reads this at a resolution finer than a day. The
/// date is the primary key, so the beacon is a single upsert with no lookup and
/// no way to write two rows for one day.
///
/// Counted client-side rather than during render because the public profile page
/// is ISR-cached -- a render-time count would either miss every cached view or
/// force the page dynamic, and the cache is the whole reason that page is cheap.
model DailyVisit {
  day   DateTime @id @db.Date
  views Int      @default(0)
}

model Playlist {
  id                 String        @id @default(cuid())
  userId             String
  /// Null for a playlist added by pasting its link, which belongs to no
  /// connected account. That distinction is load-bearing: sync marks vanished
  /// playlists stale by elimination, so it must skip rows it was never
  /// responsible for importing.
  connectedAccountId String?
  provider           MusicProvider
  externalId         String
  title              String
  description        String?
  coverImageUrl      String?
  externalUrl        String
  trackCount         Int?
  visible            Boolean       @default(true)
  sortOrder          Int           @default(0)
  isStale            Boolean       @default(false)
  lastSyncedAt       DateTime      @default(now())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectedAccount ConnectedAccount? @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  tracks           Track[]

  @@unique([userId, provider, externalId])
  @@index([userId, visible, sortOrder])
}

/// One song on a playlist, captured at sync time.
///
/// Stored rather than read live because the public profile is served to
/// visitors who hold no provider token: the owner's sync is the only moment
/// the track list can be obtained. Replaced wholesale on each sync, so there
/// is no external id to reconcile against -- position is the identity.
model Track {
  id         String  @id @default(cuid())
  playlistId String
  /// 0-based, as the provider returned it.
  position   Int
  title      String
  /// Joined artist names, or the channel for YouTube. Null when unknown.
  artist     String?
  /// Null for YouTube, whose playlistItems response omits it.
  durationMs Int?
  /// A 30-second MP3 the provider serves to anyone, or for YouTube the video's
  /// watch URL. Null when there is neither, which makes the row unplayable.
  previewUrl String?

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, position])
  @@index([playlistId, position])
}
