# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template is safe and documents every variable the app needs.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Prisma Client is generated from schema.prisma at install time (see postinstall).
/app/generated/prisma

# Local agent tooling: skill docs installed by `prisma init` plus per-developer
# editor/assistant settings. Regenerable and personal, not app code.
/.claude
/.agents
/.windsurf
skills-lock.json

# chrome-headless-shell, for promo/record.mjs
.browsers
